    { "path": "WindowsillWidgetExtension.entitlements" },
    {
      "kind": "folder",
      "path": "flower",
      "target-membership": [
        "flower",
      ],
      "membership-exceptions": [
        {
          "target": "flower",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "WindowsillWidget",
      "target-membership": [
        "WindowsillWidgetExtension",
      ],
      "membership-exceptions": [
        {
          "target": "WindowsillWidgetExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "WindowsillTests", "target-membership": [ "WindowsillTests" ] },
    {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "/System/Library/Frameworks/WidgetKit.framework", "target-membership": [ "WindowsillWidgetExtension/frameworks" ] },
        { "path": "/System/Library/Frameworks/SwiftUI.framework", "target-membership": [ "WindowsillWidgetExtension/frameworks" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/flower.app", "id": "000000000000000000000120", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/WindowsillWidgetExtension.appex", "id": "9C5F517B30A7E16D00BAA67E", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "flower/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/WindowsillTests.xctest", "id": "9C9ECED630A91ED7008D3A31", "type": "wrapper.cfbundle", "index": false },
      ],
    },
    { "kind": "folder", "path": "Shared", "target-membership": [ "WindowsillWidgetExtension", "flower" ] },
  ],
  "targets": [
    {
      "name": "flower",
      "id": "000000000000000100000000",
      "product": "Products/flower.app",
      "product-type": "application",
      "dependencies": [
        "WindowsillWidgetExtension",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_INCLUDE_ALL_APPICON_ASSETS": "YES",
        "CODE_SIGN_ENTITLEMENTS": "flower/flower.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_OUTGOING_NETWORK_CONNECTIONS": "YES",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_USER_SELECTED_FILES": "readonly",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "flower/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Windowsill",
        "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption": "NO",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.lifestyle",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UIStatusBarStyle[sdk=iphoneos*]": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UIStatusBarStyle[sdk=iphonesimulator*]": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/Frameworks",
        "LD_RUNPATH_SEARCH_PATHS[sdk=macosx*]": "@executable_path/../Frameworks",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.RohaF.windowsill",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "REGISTER_APP_GROUPS": "YES",
        "SDKROOT": "auto",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx xros xrsimulator",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2,7",
      },
    }, {
      "name": "WindowsillWidgetExtension",
      "id": "9C5F517A30A7E16D00BAA67E",
      "product": "Products/WindowsillWidgetExtension.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "ASSETCATALOG_COMPILER_WIDGET_BACKGROUND_COLOR_NAME": "WidgetBackground",
        "CODE_SIGN_ENTITLEMENTS": "WindowsillWidgetExtension.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_OUTGOING_NETWORK_CONNECTIONS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "WindowsillWidget/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "WindowsillWidget",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "",
        "IPHONEOS_DEPLOYMENT_TARGET": "27.2",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=macosx*]": [
          "$(inherited)",
          "@executable_path/../Frameworks",
          "@executable_path/../../../../Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "26.6",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.RohaF.windowsill.widget",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "REGISTER_APP_GROUPS": "YES",
        "SDKROOT": "auto",
        "SKIP_INSTALL": "YES",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx xros xrsimulator",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2,7",
        "XROS_DEPLOYMENT_TARGET": "27.2",
      },
    }, {
      "name": "WindowsillTests",
      "id": "9C9ECED530A91ED7008D3A31",
      "product": "Products/WindowsillTests.xctest",
      "product-type": "bundle.unit-test",
      "dependencies": [
        "flower",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "GENERATE_INFOPLIST_FILE": "YES",
        "IPHONEOS_DEPLOYMENT_TARGET": "27.2",
        "MACOSX_DEPLOYMENT_TARGET": "26.6",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.RohaF.windowsill.tests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "auto",
        "STRING_CATALOG_GENERATE_SYMBOLS": "NO",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx xros xrsimulator",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "NO",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2,7",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/flower.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/flower",
        "XROS_DEPLOYMENT_TARGET": "27.2",
      },
    },
  ],
  "build-settings": {
